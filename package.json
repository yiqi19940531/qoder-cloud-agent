{
  "name": "qoder-apify-commerce-research",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "setup:qoder": "node --env-file=.env.local --import tsx scripts/setup-qoder.ts",
    "smoke:qoder": "node --env-file=.env.local --import tsx scripts/smoke-qoder.ts",
    "smoke:mcp": "node --env-file=.env.local --import tsx scripts/smoke-mcp.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
