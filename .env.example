# Copy to .env.local, never commit real values.
QODER_ACCESS_TOKEN=
QODER_AGENT_ID=
QODER_ENVIRONMENT_ID=
# Written by setup:qoder after the remote Vault is created.
QODER_APIFY_VAULT_ID=
# Set to true only after the Vault holds a working Apify MCP credential.
QODER_APIFY_MCP_READY=
# One-time setup input. setup:qoder stores it in Qoder Vault and clears this line.
APIFY_API_TOKEN=
DATABASE_PATH=./data/research.db
